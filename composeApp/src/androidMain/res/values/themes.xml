<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Vora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vora_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vora_auto_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Vora</item>
    </style>
</resources>
