<resources>

    <style name="Theme.Vora" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/inter_font_family</item>
        <item name="android:statusBarColor">@color/vora_charcoal</item>
        <item name="android:navigationBarColor">@color/vora_charcoal</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Vora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vora_charcoal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vora_auto_splash_mark_padded</item>
        <item name="postSplashScreenTheme">@style/Theme.Vora</item>
    </style>
</resources>
